<?xml version="1.0" encoding="UTF-8"?>
<QESPlumeParameters>
  <plumeParameters>
    <simDur>60.0</simDur>
    <timeStep>1.0</timeStep>
    <CourantNumber>0.25</CourantNumber>
    <invarianceTol>1e-5</invarianceTol>
    <interpolationMethod>triLinear</interpolationMethod>
    <updateFrequency_particleLoop>10000</updateFrequency_particleLoop>
    <updateFrequency_timeLoop>10.0</updateFrequency_timeLoop>
  </plumeParameters>

  <collectionParameters>
    <timeAvgStart>0.0</timeAvgStart>
    <timeAvgFreq>10.0</timeAvgFreq>
    <boxBoundsX1>1.0</boxBoundsX1>
    <boxBoundsX2>35.0</boxBoundsX2>
    <boxBoundsY1>1.0</boxBoundsY1>
    <boxBoundsY2>35.0</boxBoundsY2>
    <boxBoundsZ1>1.0</boxBoundsZ1>
    <boxBoundsZ2>35.0</boxBoundsZ2>
    <nBoxesX>17</nBoxesX>
    <nBoxesY>17</nBoxesY>
    <nBoxesZ>17</nBoxesZ>
  </collectionParameters>

  <!-- Current v2.3.1 schema: particles contain one or more sources. -->
  <particleParameters>
    <baseParticle>
      <!-- The tag becomes part of the output filename. -->
      <tag>tracer</tag>
      <source>
        <!-- Set both explicitly; current source construction always copies them. -->
        <particleDensity>0.0</particleDensity>
        <particleDiameter>0.0</particleDiameter>
        <releaseType_continuous>
          <particlePerTimestep>10</particlePerTimestep>
          <massPerTimestep>1.0</massPerTimestep>
        </releaseType_continuous>
        <sourceGeometry_Point>
          <posX>10.0</posX>
          <posY>20.0</posY>
          <posZ>5.0</posZ>
        </sourceGeometry_Point>
      </source>
    </baseParticle>
  </particleParameters>

  <boundaryConditions>
    <xBCtype>exiting</xBCtype>
    <yBCtype>exiting</yBCtype>
    <zBCtype>reflection</zBCtype>
    <wallReflection>stairstepReflection</wallReflection>
  </boundaryConditions>
</QESPlumeParameters>
